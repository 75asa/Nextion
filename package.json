{
  "name": "Nextion",
  "version": "1.0.0",
  "author": "75asa <75asa.me@gmail.com>",
  "dependencies": {
    "@notionhq/client": "^0.4.9",
    "dayjs": "^1.10.7",
    "ts-command-line-args": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "repository": "git@github.com:tam-bourine/Nextion.git",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "start": "node dist/main.js",
    "start:chooseNext": "pnpm start --mode=chooseNext",
    "start:watchDone": "pnpm start --mode=watchDone",
    "start:fetchIcon": "pnpm start --mode=fetchIcon",
    "dev": "tsx src/main.ts",
    "dev:chooseNext": "pnpm dev --mode=chooseNext",
    "dev:watchDone": "pnpm dev --mode=watchDone",
    "dev:fetchIcon": "pnpm dev --mode=fetchIcon"
  },
  "packageManager": "pnpm@12.6.0"
}
